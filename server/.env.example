# Server environment. Copy to .env and fill in. Never commit real values.

# ── Core ──
PORT=3001
CLIENT_URL=http://localhost:5173
# Public site origin used to build absolute PDF download links in emails
PUBLIC_SITE_URL=https://tychosystem.com

# ── Supabase (service role — server only) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Stripe (existing checkout) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# ── Contact form bot protection ──
RECAPTCHA_SECRET_KEY=

# ── HubSpot CRM (lead-magnet funnel) ──
# Private app token with scopes: crm.objects.contacts.read/write,
# crm.objects.companies.read/write. Unset = CRM sync disabled (dev mode).
HUBSPOT_PRIVATE_APP_TOKEN=

# ── Transactional email (lead-magnet delivery; Resend-compatible adapter) ──
# Unset = delivery emails disabled (dev mode); the PDF is still served.
# Recommended production values (business email config, see docs):
#   FROM sends from the resource-delivery mailbox; REPLY_TO routes replies to
#   the general contact mailbox. Never commit real keys.
TRANSACTIONAL_EMAIL_API_KEY=
TRANSACTIONAL_EMAIL_FROM="Tycho Systems <resources@tychosystem.com>"
TRANSACTIONAL_EMAIL_REPLY_TO=contact@tychosystem.com

# ── Contract templating (existing) ──
COMPANY_NAME=
COMPANY_ADDRESS=
GOVERNING_STATE=
GOVERNING_COUNTY=
HOURLY_RATE=
