# Server environment. Copy to .env and fill in. Never commit real values.

# ── Core ──
PORT=3001
CLIENT_URL=http://localhost:5173
# Public site origin used to build absolute PDF download links in emails
PUBLIC_SITE_URL=https://tychosystem.com

# ── Supabase (service role — server only) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Stripe (existing checkout) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# ── reCAPTCHA v3 bot protection (secret half; public site key is VITE_RECAPTCHA_SITE_KEY) ──
# Protects both public forms: the strategy-call form (/api/contact) and the
# lead-magnet signup (/api/lead-magnets/subscribe). Unset = verification skipped
# (dev). Once set, submissions without a valid token / score ≥ 0.5 are rejected.
RECAPTCHA_SECRET_KEY=

# ── HubSpot CRM (lead-magnet funnel) ──
# Private app token with scopes: crm.objects.contacts.read/write,
# crm.objects.companies.read/write. Unset = CRM sync disabled (dev mode).
HUBSPOT_PRIVATE_APP_TOKEN=

# ── Transactional email (lead-magnet delivery; Resend-compatible adapter) ──
# Unset = delivery emails disabled (dev mode); the PDF is still served.
# Recommended production values (business email config, see docs):
#   FROM sends from the resource-delivery mailbox; REPLY_TO routes replies to
#   the general contact mailbox. Never commit real keys.
TRANSACTIONAL_EMAIL_API_KEY=
TRANSACTIONAL_EMAIL_FROM="Tycho Systems <resources@tychosystem.com>"
TRANSACTIONAL_EMAIL_REPLY_TO=contact@tychosystem.com

# ── Marketing email + unsubscribe ──
# REQUIRED before any marketing email can be sent. Signs the opaque unsubscribe
# tokens (AES-256-GCM). Generate with: openssl rand -base64 48
# Minimum 24 characters. Unset = sendMarketingEmail() refuses to send, because
# it cannot produce a working unsubscribe link. Transactional email is
# unaffected. Rotating this invalidates unsubscribe links in already-sent
# emails, so treat it as long-lived.
UNSUBSCRIBE_TOKEN_SECRET=

# Optional: separate sender for bulk/marketing mail so its reputation is kept
# apart from receipts, contracts and password resets. Falls back to
# TRANSACTIONAL_EMAIL_FROM when unset.
MARKETING_EMAIL_FROM=

# Optional: HubSpot subscription type id for marketing email. When set, an
# unsubscribe also calls HubSpot's communication-preferences API, which opts the
# contact out portal-wide rather than only clearing tycho_marketing_consent.
# Find it under Settings → Marketing → Email → Subscription types.
HUBSPOT_MARKETING_SUBSCRIPTION_ID=

# ── Contract templating (existing) ──
COMPANY_NAME=
COMPANY_ADDRESS=
GOVERNING_STATE=
GOVERNING_COUNTY=
HOURLY_RATE=
