# Frontend environment (Vite — everything here is PUBLIC in the client bundle).
# Copy to .env and fill in. Never put CRM/email/service-role secrets here.
#
# Business email addresses are NOT configured here. Public-facing addresses live
# in src/config/contact.ts; server notification routing and the transactional
# sender/reply-to are configured server-side (see server/.env.example).

# Backend API origin in production (unset in dev — Vite proxies /api to :3001)
VITE_API_URL=

# Supabase public (anon) credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# reCAPTCHA v3 site key (public) — protects the strategy-call and lead-magnet forms.
# Pair with RECAPTCHA_SECRET_KEY on the server. Unset = bot check disabled (dev).
VITE_RECAPTCHA_SITE_KEY=

# ── Analytics (optional, consent-gated) ──
# Plausible domain, e.g. tychosystem.com. UNSET BY DEFAULT AND CURRENTLY UNSET
# IN PRODUCTION: with no value, no analytics script is loaded and no analytics
# provider is contacted at all. Setting it enables Plausible — but it still only
# loads for visitors who have granted the "Analytics" cookie category.
# Before setting this, update src/content/legal/cookie-policy.md, which
# currently states that analytics is not in use.
VITE_PLAUSIBLE_DOMAIN=

# Optional override for the Plausible script URL (self-hosted or a proxied
# path). Defaults to https://plausible.io/js/script.js.
VITE_PLAUSIBLE_SRC=
